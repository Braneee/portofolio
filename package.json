{
  "name": "gibran-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src/app/page.tsx src/app/projects src/app/resume src/app/blog src/app/contact src/app/globals.css src/content src/components/layout src/components/brand src/components/projects src/components/contact src/components/home tests playwright.config.ts package.json eslint.config.mjs postcss.config.mjs tsconfig.json .prettierrc.json",
    "audit:a11y": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.400.0",
    "motion": "^13.2.0",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,css,json}": [
      "prettier --write"
    ],
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix"
    ]
  }
}
